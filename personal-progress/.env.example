# In a Feishu group, add a Custom Bot and paste its webhook URL here.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id

# Optional. Set this when the Custom Bot uses signature verification.
FEISHU_WEBHOOK_SECRET=

# Required when deploying with Vercel Cron. Use a long random value.
CRON_SECRET=

# Optional. Included in the daily reminder as a link back to this app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase account login and per-user cloud records.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feishu self-built app: receives messages sent to the app bot.
# These are server-only secrets. Never put them in NEXT_PUBLIC_* variables.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Secret shared by the deployed Feishu long-connection worker and this website.
# Set a different long random value instead of reusing the App Secret.
FEISHU_INGEST_SECRET=

# The public URL for this site's Feishu event endpoint, used only by the worker.
DAILY_SPACE_INGEST_URL=http://localhost:3000/api/feishu/events

# Used only by server routes that write a bound user's records and upload images.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed by the deployed Feishu long-connection worker. It can use the
# same Project URL as NEXT_PUBLIC_SUPABASE_URL, but should not expose it to UI.
SUPABASE_URL=
